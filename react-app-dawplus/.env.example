VITE_MODE=dist
VITE_APP_TITLE=React-APP

VITE_MAIN_SCROLL_CONTAINER_ID="main-container"

VITE_BASE_PATH=/
VITE_BASE_PORT=5173
# Cafe24 운영 API (cama-plus-app PROD 와 동일)
VITE_API_SERVER=https://camaplus.cafe24.com/

VITE_APP_KEY=tanstack.auth.user
VITE_ENCRYPTION_SECRET=change-this-secret-in-production

# Development Test Token (development only)
VITE_DEV_TEST_TOKEN=
VITE_DEV_BYPASS_AUTH=false

VITE_LOGIN_PAGE=/login
VITE_DEFAULT_PAGE=/home

# Layout
VITE_MAX_WIDTH=1024

VITE_ACCOUNT_ID=your-account-id
