# Cafe24 PROD — react-app-dawplus (cama-plus-app stage.ts 와 동일 호스트)
# 사용: copy .env.cafe24.example .env

VITE_MODE=dist
VITE_APP_TITLE=CAMA Plus Web

VITE_MAIN_SCROLL_CONTAINER_ID=main-container

VITE_BASE_PATH=/
VITE_BASE_PORT=5173
VITE_API_SERVER=https://camaplus.cafe24.com/

VITE_APP_KEY=tanstack.auth.user
VITE_ENCRYPTION_SECRET=change-this-secret-in-production
VITE_DEV_BYPASS_AUTH=false

VITE_LOGIN_PAGE=/login
VITE_DEFAULT_PAGE=/home

VITE_MAX_WIDTH=1024

# WebView 개발용: RN 로그인 후 전달되는 loginId (운영에서는 URL/postMessage 로 대체)
VITE_ACCOUNT_ID=

# 개발 시 서버 JWT (선택)
# VITE_DEV_TEST_TOKEN=
