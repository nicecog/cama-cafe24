{
  "name": "camaapp",
  "version": "1.1.2",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "reset-cache": "react-native start --reset-cache",
    "reinstall": "rm -rf ./node_modules;npm install",
    "clean": "cd ./android && ./gradlew clean && cd ..",
    "pod": "npx pod-install ios",
    "open-xcode": "open ./ios/CamaApp.xcworkspace",
    "android-build:apk:dev": "npm run clean && cd android && ./gradlew assembleRelease  && npm run open-android-build-folder",
    "android-build:apk": "npm run clean && cd android && ./gradlew assembleRelease  && npm run open-android-build-folder",
    "android-build:aab": "npm run clean && cd android && ./gradlew bundleRelease && npm run open-android-build-folder:aab",
    "open-android-build-folder": "open ./android/app/build/outputs/apk/",
    "open-android-build-folder:aab": "open ./android/app/build/outputs/bundle/release",
    "bump-patch": "npm version patch --no-git-tag-version && cd ios && bundle exec fastlane bump",
    "bump-minor": "npm version minor --no-git-tag-version && cd ios && bundle exec fastlane bump",
    "bump-major": "npm version major --no-git-tag-version && cd ios && bundle exec fastlane bump"
  },
  "dependencies": {
    "@fxts/core": "^0.17.0",
    "@react-native-community/push-notification-ios": "^1.11.0",
    "@react-native-firebase/app": "^18.5.0",
    "@react-native-firebase/messaging": "^18.5.0",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/native-stack": "^6.9.13",
    "axios": "0.27.2",
    "dayjs": "^1.11.9",
    "iamport-react-native": "^2.0.5",
    "lodash": "^4.17.21",
    "react": "18.2.0",
    "react-native": "0.71.1",
    "react-native-bootsplash": "^5.0.2",
    "react-native-chart-kit": "^6.12.0",
    "react-native-device-info": "^10.8.0",
    "react-native-dropdown-select-list": "^2.0.5",
    "react-native-encrypted-storage": "^4.0.3",
    "react-native-image-picker": "5.2.0",
    "react-native-iphone-screen-helper": "^2.0.3",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-modal": "^13.0.1",
    "react-native-permissions": "^5.3.0",
    "react-native-push-notification": "^8.1.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "^4.6.4",
    "react-native-screens": "^3.22.1",
    "react-native-svg": "^13.10.0",
    "react-native-swipe-list-view": "^3.2.9",
    "react-native-tts": "^4.1.0",
    "react-native-uuid": "^2.0.1",
    "react-native-webview": "^13.3.1",
    "recoil": "^0.7.7"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/eslint-config": "^3.0.0",
    "@tsconfig/react-native": "^2.0.2",
    "@types/iamport-react-native": "^1.5.2",
    "@types/jest": "^29.2.1",
    "@types/lodash": "^4.14.197",
    "@types/react": "^18.0.24",
    "@types/react-native-push-notification": "^8.1.2",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.2.1",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.19.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.73.7",
    "prettier": "^2.4.1",
    "react-native-svg-transformer": "^1.0.0",
    "react-test-renderer": "18.2.0",
    "typescript": "4.8.4"
  },
  "jest": {
    "preset": "react-native"
  }
}
