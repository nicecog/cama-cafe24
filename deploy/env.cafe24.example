# Cafe24 VPS 운영 — docker compose --env-file .env.cafe24
# cp env.cafe24.example .env.cafe24 후 값 채우기 (Git 커밋 금지)

# ── 공개 도메인 (무료도메인 FQDN, https 기본 적용) ──
PUBLIC_HOST=camaplus.cafe24.com
# Super Admin SPA: https://camaplus.cafe24.com/admin/ (container cama-super-admin:8083)

# ── react-app-dawplus (환자 WebView SPA) ──
REACT_APP_WWW_ROOT=/opt/cama/www/react-app
# PC 배포 스크립트: deploy/scripts/deploy-react-app-cafe24.ps1
# CAMA_SSH_TARGET=root@YOUR_VPS_IP

# ── PostgreSQL ──
POSTGRES_USER=cama
POSTGRES_PASSWORD=admincama!
POSTGRES_DB=cama

# ── API (cama-plus-server) ──
JWT_CLIENT_SECRET=admincama!
IAMPORT_KEY=
IAMPORT_SECRET=
CAMA_STORAGE_TYPE=local
FILE_STORAGE_PATH=/opt/cama/data/cama-files
IMAGE_CDN_BASE_URL=https://camaplus.cafe24.com/files
CAMA_CORS_ORIGINS=https://camaplus.cafe24.com
CAMA_MAIL_ENABLED=false
CAMA_MAIL_FROM=noreply@camaplus.com
# brevo-api (권장, xkeysib) | smtp (xsmtpsib + @smtp-brevo.com 로그인)
CAMA_MAIL_PROVIDER=brevo-api
CAMA_MAIL_SENDER_NAME=CAMA Plus
BREVO_API_KEY=xkeysib-your-api-key-here
# SMTP 방식 (CAMA_MAIL_PROVIDER=smtp 일 때)
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=7abcd123@smtp-brevo.com
SPRING_MAIL_PASSWORD=xsmtpsib-your-smtp-key-here

# ── Batch (cama-back-batch) ──
# 추후 실제 Firebase 서비스 계정 JSON으로 교체
FIREBASE_CREDENTIALS_PATH=/secrets/firebase-adminsdk.json
CAMA_BATCH_FCM_DRY_RUN=true
CAMA_BATCH_SLACK_ENABLED=false

# ── Doctor web (cama-doctor-web) — Docker 내부 API (공개 URL 아님) ──
CAMA_BILLIVE_BASE_URL=http://cama-plus-server:8080
CAMA_FIREBASE_ENABLED=false
# 최초 1회 DB 테이블 생성 후 validate 권장
SPRING_JPA_HIBERNATE_DDL_AUTO=update
