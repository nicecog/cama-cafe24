# One-time AWS → Cafe24 file migration credentials (copy → local-aws-migrate.env, never commit)
AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET=cama-images
S3_LEGACY_BUCKET=cama-files
S3_BUCKET=cama-images

# Cafe24 VPS (optional — defaults from CAFE24_VPS_ACCESS.local.md)
# CAMA_VPS_HOST=210.114.18.156
# CAMA_VPS_SSH_PASSWORD=

# Public file base after migration
CAFE24_FILES_BASE=https://camaplus.cafe24.com/files
VPS_FILES_DIR=/opt/cama/data/cama-files
