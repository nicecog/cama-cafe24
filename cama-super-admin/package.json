{
  "name": "cama-doctor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:dev": "tsc && vite build --mode development",
    "build:prod": "tsc &&  vite build --mode production",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "deploy:dev": "npm run build:dev && aws s3 sync ./dist s3://cama-admin/ --profile=camaProf",
    "deploy:prod": "npm run build:prod && aws s3 sync ./dist s3://cama-admin-prod/ --profile=camaProf",
    "invalidate:prod": "npm run deploy:prod && aws cloudfront create-invalidation --profile=camaProf --distribution-id E3CXVSCNA31GN8 --paths /index.html"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.18",
    "@reduxjs/toolkit": "^2.1.0",
    "@tanstack/react-query": "^5.20.2",
    "@tanstack/react-query-devtools": "^5.20.2",
    "ag-grid-community": "^32.1.0",
    "ag-grid-react": "^32.1.0",
    "apexcharts": "^4.1.0",
    "axios": "^1.6.7",
    "clsx": "^2.1.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.0.20",
    "i18next": "^25.7.1",
    "jotai": "^2.8.3",
    "lottie-react": "^2.4.1",
    "minizip-asm.js": "^1.0.10",
    "path": "^0.12.7",
    "query-string": "^9.0.0",
    "react": "^18.2.0",
    "react-apexcharts": "^1.4.1",
    "react-cookie": "^7.0.2",
    "react-datepicker": "^7.5.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.3.5",
    "react-icons": "^5.0.1",
    "react-player": "^2.15.1",
    "react-quill": "^2.0.0",
    "react-redux": "^9.1.0",
    "react-responsive": "^9.0.2",
    "react-router-dom": "^6.21.3",
    "react-tailwindcss-datepicker": "^1.6.6",
    "sweetalert2": "^11.11.1",
    "swiper": "^11.2.6",
    "tailwind-merge": "^2.5.5",
    "usehooks-ts": "^2.13.0",
    "vite-tsconfig-paths": "^4.3.1",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
