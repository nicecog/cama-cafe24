# Cafe24 VPS — CAMA Super Admin static SPA (nginx)
# Build: Node 20 LTS | Runtime: nginx alpine
# API: https://camaplus.cafe24.com (cama-plus-server Spring Boot 3.5 / JDK 21)

FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json* yarn.lock* ./
RUN if [ -f yarn.lock ]; then yarn install --frozen-lockfile --non-interactive; else npm ci; fi

COPY . .
COPY .env.cafe24.example .env

ARG PUBLIC_URL=/admin
ENV PUBLIC_URL=${PUBLIC_URL}
ENV REACT_APP_PROFILE=cafe24
ENV REACT_APP_API_URL=https://camaplus.cafe24.com
ENV GENERATE_SOURCEMAP=false
ENV TSC_COMPILE_ON_ERROR=true
ENV DISABLE_ESLINT_PLUGIN=true

RUN if [ -f yarn.lock ]; then yarn build:cafe24; else npm run build:cafe24; fi

FROM nginx:1.27-alpine
COPY deploy/nginx-container.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
