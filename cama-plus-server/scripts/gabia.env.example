# 가비아 컨테이너 배포 시 환경변수 예시 (값은 Gabia 콘솔/DB 생성 후 채우세요)
# cp scripts/gabia.env.example scripts/gabia.env  후 수정

SPRING_PROFILES_ACTIVE=gabia

SERVER_PORT=8080

# PostgreSQL (컨테이너 내장 또는 Gabia DB 호스팅)
DB_URL=jdbc:postgresql://YOUR_DB_HOST:5432/cama
DB_USER=cama
DB_PASSWORD=

# JWT / 결제 (기존 운영 값을 env 로 이전, 저장소에 커밋 금지)
JWT_CLIENT_SECRET=
IAMPORT_KEY=
IAMPORT_SECRET=

# 이미지: Gabia 디스크 저장 (storage-type=local, AWS 불필요)
# Gabia 컨테이너의 웹/영구 볼륨 경로로 지정 (예: /home/xxx/www/files)
FILE_STORAGE_PATH=/home/cama/files
IMAGE_CDN_BASE_URL=https://api.cama.ai.kr/files

# FCM HTTP v1 (Firebase Admin SDK) — 서비스 계정 JSON 절대 경로
FIREBASE_CREDENTIALS_PATH=/home/cama/secrets/firebase-adminsdk.json

# MySQL 사용 시: SPRING_PROFILES_ACTIVE=gabia-mysql
# DB_URL=jdbc:mysql://YOUR_DB_HOST:3306/cama?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci&allowPublicKeyRetrieval=true

# AWS S3 사용 시 (legacy local/prd 프로필): cama.hosting.storage-type=s3
